# ================================================================
#  CodificaMed - Codificación Automática CIE-10 con PLN
# ================================================================

# Proveedor activo: "ollama" (local) o "claude" (nube)
LLM_PROVIDER=ollama

# Configuración Ollama (modelo local en http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=300

# API externa (Claude / Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Búsqueda sobre el catálogo CIE-10 ("lexico" usa BM25 con stemming)
INDEX_MODE=lexico

# Servidor web
PUERTO=8001
